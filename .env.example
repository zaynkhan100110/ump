# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
UMP_SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
UMP_COOKIE_SECURE=0
UMP_TRUST_PROXY=0
UMP_ALLOW_REGISTRATION=0

# Data paths default to each operating system's application-data directory via platformdirs.
# Set UMP_DATA_DIR only if you want to override that location.
# UMP_DATA_DIR=/absolute/path/to/ump-data
# UMP_DOWNLOAD_DIR and UMP_DATABASE_PATH default beneath UMP_DATA_DIR.
# UMP_TEMP_DIR defaults to UMP_DATA_DIR/tmp.

# Performance / resource limits
UMP_MAX_CONCURRENT=3
UMP_MAX_QUEUED_JOBS=100
UMP_MAX_USER_ACTIVE=3
UMP_MAX_DOWNLOAD_BYTES=5368709120
UMP_METADATA_TIMEOUT=150
UMP_SOCKET_TIMEOUT=30
UMP_METADATA_CACHE_TTL=900
UMP_METADATA_CACHE_MAX_ENTRIES=500
UMP_JOB_TTL_SECONDS=3600
# Delete the staged server-side copy after the browser finishes retrieving it.
UMP_DELETE_AFTER_DOWNLOAD=1

# Optional authentication for sites that require it. Protect this file and never commit it.
# UMP_COOKIES_FILE=/absolute/path/to/cookies.txt
# Or browser cookies, e.g. firefox, chrome, chromium. The browser profile must be readable.
# UMP_COOKIES_FROM_BROWSER=firefox

# Optional explicit yt-dlp executable
# YTDLP_PATH=/absolute/path/to/yt-dlp
LOG_LEVEL=INFO

# Rumble impersonation profiles, in preferred order. These are observations,
# not guaranteed bypasses; availability varies by IP/network and site policy.
UMP_RUMBLE_IMPERSONATE_PROFILES=Safari-18.4:Macos-15,Safari-18.0:Macos-15,Chrome-151:Windows-10,Chrome-152:Windows-10,Chrome-150:Macos-26
